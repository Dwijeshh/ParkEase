generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SECURITY
  ADMIN
}

enum VehicleType {
  CAR
  BIKE
}

enum ParkingSlotStatus {
  VACANT
  ENGAGED
  WAITING
  MAINTENANCE
}

enum AllocationStatus {
  ACTIVE
  RELEASED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
}

enum MapNodeType {
  ENTRY
  EXIT
  JUNCTION
  PARKING
  MALL_ENTRY
}

enum MapDirectionType {
  ONE_WAY
  TWO_WAY
}

model User {
  id        BigInt   @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles    Vehicle[]
  allocations ParkingAllocation[]
  sessions    ParkingSession[]
}

model Admin {
  id        BigInt   @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Vehicle {
  id                 BigInt      @id @default(autoincrement())
  registrationNumber String      @unique
  type               VehicleType
  userId             BigInt
  createdAt          DateTime    @default(now())

  user        User                @relation(fields: [userId], references: [id])
  allocations ParkingAllocation[]
  sessions    ParkingSession[]
}

model ParkingLot {
  id         BigInt   @id @default(autoincrement())
  name       String
  location   String
  totalSlots Int
  baseFee    Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())

  slots ParkingSlot[]
}

model ParkingSlot {
  id         BigInt            @id @default(autoincrement())
  lotId      BigInt
  slotNumber String
  slotType   VehicleType
  status     ParkingSlotStatus @default(VACANT)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  lot         ParkingLot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  allocations ParkingAllocation[]
  sessions    ParkingSession[]

  @@unique([lotId, slotNumber])
}

model ParkingAllocation {
  id          BigInt           @id @default(autoincrement())
  userId      BigInt
  vehicleId   BigInt
  slotId      BigInt
  allocatedAt DateTime         @default(now())
  releasedAt  DateTime?
  status      AllocationStatus @default(ACTIVE)

  user    User            @relation(fields: [userId], references: [id])
  vehicle Vehicle         @relation(fields: [vehicleId], references: [id])
  slot    ParkingSlot     @relation(fields: [slotId], references: [id])
  session ParkingSession?

  @@index([userId])
  @@index([vehicleId])
  @@index([slotId])
}

model ParkingSession {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt
  vehicleId    BigInt
  slotId       BigInt
  allocationId BigInt        @unique
  entryTime    DateTime
  exitTime     DateTime?
  amount       Decimal       @default(0) @db.Decimal(10, 2)
  status       SessionStatus @default(ACTIVE)

  user       User              @relation(fields: [userId], references: [id])
  vehicle    Vehicle           @relation(fields: [vehicleId], references: [id])
  slot       ParkingSlot       @relation(fields: [slotId], references: [id])
  allocation ParkingAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vehicleId])
  @@index([slotId])
}

model MapNode {
  id          Int         @id @default(autoincrement())
  nodeType    MapNodeType
  xCoordinate Float
  yCoordinate Float

  outgoingEdges MapEdge[]      @relation("MapEdgeFrom")
  incomingEdges MapEdge[]      @relation("MapEdgeTo")
  parkingRoutes ParkingRoute[] @relation("ParkingRouteNode")
  sourceRoutes  ParkingRoute[] @relation("ParkingRouteSource")
  exitRoutes    MapExitRoute[] @relation("ExitRouteNode")
  destinations  MapExitRoute[] @relation("ExitRouteDestination")
}

model MapEdge {
  id            Int              @id @default(autoincrement())
  fromNodeId    Int
  toNodeId      Int
  distance      Float
  directionType MapDirectionType @default(ONE_WAY)

  fromNode MapNode @relation("MapEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   MapNode @relation("MapEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([fromNodeId])
  @@index([toNodeId])
}

model ParkingRoute {
  parkingNodeId Int   @id
  sourceNodeId  Int
  totalDistance Float
  routeNodes    Int[]

  parkingNode MapNode @relation("ParkingRouteNode", fields: [parkingNodeId], references: [id], onDelete: Cascade)
  sourceNode  MapNode @relation("ParkingRouteSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
}

model MapExitRoute {
  parkingNodeId     Int   @id
  destinationNodeId Int
  totalDistance     Float
  routeNodes        Int[]

  parkingNode     MapNode @relation("ExitRouteNode", fields: [parkingNodeId], references: [id], onDelete: Cascade)
  destinationNode MapNode @relation("ExitRouteDestination", fields: [destinationNodeId], references: [id], onDelete: Cascade)
}
